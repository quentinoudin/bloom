# Auto detect text files and normalize line endings to LF
* text=auto

# Keep these files with LF endings
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Binary files
*.png binary
*.svg binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
